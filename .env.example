# Vercel -> Project -> Settings -> Environment Variables (Production)
# SUMBER: Portal Koku (READ-ONLY)
SUPABASE_URL=https://sxmchnwzcbsanecxnqdt.supabase.co
SUPABASE_SECRET_KEY=YOUR_KOKU_SUPABASE_SECRET_KEY

# DESTINASI: projek Supabase PBD-UASA BERASINGAN; jalankan migrations/001_pbd_separate_project.sql
PBD_SUPABASE_URL=YOUR_PBD_SUPABASE_URL
PBD_SUPABASE_SECRET_KEY=YOUR_PBD_SUPABASE_SECRET_KEY

# Jana secret rawak sekurang-kurangnya 32 aksara
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS
# Jangan commit atau kongsi secret. Jangan guna NEXT_PUBLIC_ untuk kunci server.
